{
    "name": "nosto/shopware6-job-scheduler",
    "description": "System library for async job scheduling for Shopware 6",
    "type": "library",
    "version": "3.0.2",
    "license": "OSL-3.0",
    "autoload": {
        "psr-4": {
            "Nosto\\Scheduler\\": "src/"
        }
    },
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "shopware/administration": "^6.6",
        "symplify/easy-coding-standard": "^12.0",
        "slevomat/coding-standard": "8.13.1"
    },
    "config": {
        "platform": {
            "php": "8.2"
        },
        "allow-plugins": {
            "symfony/runtime": true,
            "dealerdirect/phpcodesniffer-composer-installer": false
        }
    },
    "scripts": {
        "lint": "./vendor/bin/ecs check",
        "fix": "./vendor/bin/ecs check --fix"
    }
}
