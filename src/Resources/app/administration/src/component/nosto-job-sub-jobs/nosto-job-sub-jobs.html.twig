{% block nosto_job_sub_jobs_base %}
    <div class="sub-jobs-container">
        <div class="sub-jobs-filter-bar">
            <sw-select-field
                    v-model:value="statusFilter"
                    :label="$tc('job-listing.page.listing.index.status-filter')"
                    class="sub-jobs-status-filter"
                    @change="loadSubJobs"
            >
                <option value="all">{{ $tc('job-listing.page.listing.index.all-statuses') }}</option>
                <option v-for="status in statusOptions" :key="status" :value="status">
                    {{ $tc('job-listing.page.listing.grid.job-status.' + status, status) }}
                </option>
            </sw-select-field>
            <sw-select-field
                v-model:value="nameFilter"
                :label="$tc('job-listing.page.listing.index.name-filter', 'Filter by Name')"
                class="sub-jobs-name-filter"
                style="max-width: 250px; margin-left: 16px;"
            >
                <option value="">{{ $tc('job-listing.page.listing.index.all-names', 'All Names') }}</option>
                <option v-for="name in nameOptions" :key="name" :value="name">{{ name }}</option>
            </sw-select-field>
        </div>

        {% block job_children_listing %}
            <sw-entity-listing
                v-if="!isLoading && filteredSubJobs"
                :items="filteredSubJobs"
                :columns="jobChildrenColumns"
                :repository="jobRepository"
                :showSelection="false"
                :isLoading="isLoading"
                :allowInlineEdit="false"
                :allowColumnEdit="false"
                :sortBy="sortBy"
                :sortDirection="sortDirection"
                :naturalSorting="false"
                :total="filteredSubJobs.length"
                :page="page"
                :limit="limit"
                :disableDataFetching="true"
                @column-sort="onSortColumn"
                @page-change="onPageChange"
            >
                <template #column-status="{ item }">
                    <nosto-job-status-badge :status="item.status"></nosto-job-status-badge>
                    {{ $tc('job-listing.page.listing.grid.job-status.' + item.status) }}
                </template>

                <template #column-startedAt="{ item }">
                    {{ formatDate(item.startedAt) }}
                </template>

                <template #column-finishedAt="{ item }">
                    {{ formatDate(item.finishedAt) }}
                </template>

                <template #column-createdAt="{ item }">
                    {{ formatDate(item.createdAt) }}
                </template>

                <template #column-messages="{ item }">
                    <div :class="item.messages.length > 0 ? 'has-messages' : ''"
                         class="message-counters-container jobs-info-counter">
                        <div class="count-container" v-if="item.messages">
                            <span class="info-counter">
                                <span class="count">{{ getMessagesCount(item, 'info') }}</span>
                            </span>
                            <sw-icon name="regular-info-circle" size="16px" color="#3498db"></sw-icon>
                        </div>

                        <div class="count-container" v-if="item.messages">
                            <span class="warning-counter">
                                <span class="count">{{ getMessagesCount(item, 'warning') }}</span>
                            </span>
                            <sw-icon name="regular-exclamation-triangle" size="16px" color="#f39c12"></sw-icon>
                        </div>

                        <div class="count-container" v-if="item.messages">
                            <span class="error-counter">
                                <span class="count">{{ getMessagesCount(item, 'error') }}</span>
                            </span>
                            <sw-icon name="regular-times-hexagon" size="16px" color="#c0392b"></sw-icon>
                        </div>
                    </div>
                    <sw-button v-if="item.messages && item.messages.length > 0"
                              class="job-messages-show-modal"
                              size="x-small"
                              variant="primary"
                              @click="showMessages(item)">
                        <sw-icon name="regular-envelope" color="#fff" size="12px" decorative></sw-icon>
                        {{ $tc('job-listing.page.listing.index.show-job-messages') }}
                    </sw-button>
                </template>
            </sw-entity-listing>
            <sw-loader v-if="isLoading"></sw-loader>
        {% endblock %}

        {% block nosto_job_messages_modal %}
            <sw-modal class="nosto-job-messages-modal"
                    v-if="showMessagesModal"
                    :title="$tc('job-listing.page.listing.grid.column.messages')"
                    variant="default"
                    size="650px"
                    @modal-close="showMessagesModal = false">
                {% block job_messages_listing %}
                    <div v-if="currentJobMessages" class="job_list_grid_job_messages-information">
                        <template v-for="message in currentJobMessages">
                            <div class="messages-content">
                                <sw-alert v-if="message.type === 'error-message'"
                                        class="nosto-alert"
                                        variant="error"
                                        appearance="notification"
                                        :showIcon="true"
                                        :closable="false">
                                    {{ message.message }}
                                </sw-alert>
                                <sw-alert v-if="message.type === 'info-message'"
                                        class="nosto-alert"
                                        variant="info"
                                        appearance="notification"
                                        :showIcon="true"
                                        :closable="false">
                                    {{ message.message }}
                                </sw-alert>
                                <sw-alert v-if="message.type === 'warning-message'"
                                        class="nosto-alert"
                                        variant="warning"
                                        appearance="notification"
                                        :showIcon="true"
                                        :closable="false">
                                    {{ message.message }}
                                </sw-alert>
                            </div>
                        </template>
                    </div>
                {% endblock %}
                <template #modal-footer>
                    <sw-button variant="primary"
                            size="small"
                            @click="showMessagesModal = false">
                        {{ $tc('job-listing.page.listing.index.close') }}
                    </sw-button>
                </template>
            </sw-modal>
        {% endblock %}
    </div>
{% endblock %}