{% block nosto_job_sub_jobs_base %}
    <div class="sub-jobs-container">
        <div class="sub-job-container" v-if="subJobs">
            {% block job_children_listing %}
                <nosto-entity-listing
                        v-if="subJobs"
                        :items="subJobs"
                        :data-source="subJobs"
                        :repository="jobRepository"
                        :showSelection="false"
                        :allowColumnEdit="false"
                        :compactMode="false"
                        :allowDelete="false"
                        :allowEdit="false"
                        :columns="jobChildrenColumns">
                    <template #column-name="{ item }">
                        {% block job_list_grid_job_name_link %}
                            {{ item.name }}
                        {% endblock %}
                    </template>
                    <template #column-status="{ item }">
                        {% block job_list_grid_job_status_link %}
                            <nosto-job-status-badge :status="item.status" :show-label="true"></nosto-job-status-badge>
                        {% endblock %}
                    </template>

                    <template #column-startedAt="{ item }">
                        {% block job_list_grid_job_started_at %}
                            {{ formatDate(item.startedAt) }}
                        {% endblock %}
                    </template>
                    <template #column-finishedAt="{ item }">
                        {% block job_list_grid_job_finished_at %}
                            {{ formatDate(item.finishedAt) }}
                        {% endblock %}
                    </template>
                    <template #column-createdAt="{ item }">
                        {% block job_list_grid_job_created_at %}
                            {{ formatDate(item.createdAt) }}
                        {% endblock %}
                    </template>
                    <template #column-messages="{ item }">
                        {% block sub_job_show_messages_button %}
                            <div :class="getMessagesTotalCount(item) > 0 ? 'has-messages' : ''" class="message-counters-container jobs-info-counter">
                                <div class="count-container">
                            <span class="info-counter">
                                <span class="count">{{ getMessagesCount(item, 'info') }}</span>
                            </span>
                                    <mt-icon size="16px" name="regular-info-circle" color="#3498db"></mt-icon>
                                </div>

                                <div class="count-container">
                            <span class="warning-counter">
                                <span class="count">{{ getMessagesCount(item, 'warning') }}</span>
                            </span>
                                    <mt-icon size="16px" name="regular-exclamation-triangle" color="#f39c12"></mt-icon>
                                </div>

                                <div class="count-container">
                            <span class="error-counter">
                                <span class="count">{{ getMessagesCount(item, 'error') }}</span>
                            </span>
                                    <mt-icon size="16px" name="regular-times-hexagon" color="#c0392b"></mt-icon>
                                </div>
                            </div>
                            <mt-button v-if="getMessagesTotalCount(item) > 0"
                                       class="job-messages-show-modal"
                                       size="small"
                                       variant="primary"
                                       @click="showMessageModal(item)">
                                <mt-icon name="regular-envelope" color="#fff" size="16px" :decorative="true"></mt-icon>
                                {{ $tc('job-listing.actions.show-messages.button.label') }}
                            </mt-button>
                        {% endblock %}
                    </template>
                    <template #actions="{ item }">
                        <sw-context-menu-item :disabled="item.status !== 'error'"
                                              @click="rescheduleJob(item.id)">
                            {{ $tc('job-listing.actions.reschedule-job.button.label') }}
                        </sw-context-menu-item>
                        <sw-context-menu-item v-if="getMessagesTotalCount(item) > 0"
                                              @click="showMessageModal(item)">
                            {{ $tc('job-listing.actions.show-messages.button.label') }}
                        </sw-context-menu-item>
                    </template>
                </nosto-entity-listing>
            {% endblock %}
        </div>
        <div v-else>
            {{ $tc('job-listing.page.listing.index.loading') }}
        </div>
        <sw-modal class="nosto-job-messages-modal" v-if="showMessagesModal" :title="$tc('job-listing.page.listing.grid.column.messages')"
                  @modal-close="closeMessagesModal">
            {% block job_messages_listing %}
                <div v-if="currentJobMessages" class="job_list_grid_job_messages-information" style="width:100%;">
                    <div class="messages-content" v-for="item in currentJobMessages">
                        <mt-banner class="nosto-alert"
                                   v-if="item.type == 'info-message'"
                                   variant="info"
                                   :showIcon="true"
                                   :closable="false">
                            {{ item.message }}
                        </mt-banner>

                        <mt-banner class="nosto-alert"
                                   v-if="item.type == 'error-message'"
                                   variant="critical"
                                   :showIcon="true"
                                   :closable="false">
                            {{ item.message }}
                        </mt-banner>

                        <mt-banner class="nosto-alert"
                                   v-if="item.type == 'warning-message'"
                                   variant="attention"
                                   :showIcon="true"
                                   :closable="false">
                            {{ item.message }}
                        </mt-banner>
                    </div>
                </div>
            {% endblock %}
            <template #modal-footer>
                <mt-button variant="primary"
                           @click="closeMessagesModal">
                    {{ $tc('job-listing.page.listing.index.close') }}
                </mt-button>
            </template>
        </sw-modal>
    </div>
{% endblock %}
