{% block nosto_job_charts_base %}
<div class="nosto-scheduler-charts">
    <div class="sw-dashboard-statistics__card-headline-select">
        <mt-select
            v-if="jobDisplayType !== 'list'"
            :label="$tc('job-listing.page.listing.index.display-mode')"
            v-model="statisticDateRanges.value"
            :options="Object.keys(statisticDateRanges.options).map(key => ({
                value: key,
                label: $tc(`sw-dashboard.monthStats.dateRanges.${key}`)
            }))"
            size="small"
            class="charts-date-range"
        />


    </div>
    <sw-chart
            type="area"
            :series="chartSeries"
            :options="chartOptionsCount"
            :fill-empty-values="getTimeUnitInterval"
            :fillEmptyDates="false"
            :sort="true"
    />
</div>
{% endblock %}
