<?xml version="1.0" encoding="UTF-8"?>

<phpunit
    bootstrap="tests/bootstrap.php"
    cacheResult="false"
>
    <php>
        <ini name="error_reporting" value="-1"/>
    </php>

    <testsuites>
        <testsuite name="Nosto Scheduler Tests">
            <directory>tests/</directory>
        </testsuite>
    </testsuites>
</phpunit>
